[Unit]
Description=Star Explorer HTTPS proxy
After=network-online.target star.service
Wants=network-online.target

[Service]
Type=notify
DynamicUser=true
StateDirectory=star-caddy
ConfigurationDirectory=star-caddy
Environment=XDG_DATA_HOME=/var/lib/star-caddy
Environment=XDG_CONFIG_HOME=/var/lib/star-caddy/config
Environment=GOMEMLIMIT=48MiB
ExecStart=/opt/star/runtime/caddy run --config /etc/star-caddy/Caddyfile --adapter caddyfile
ExecReload=/opt/star/runtime/caddy reload --config /etc/star-caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target
