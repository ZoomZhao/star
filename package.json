{
  "name": "star-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "dev:server": "node --env-file=.env.development server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "android:open": "open -a \"Android Studio\" android",
    "android:build": "bash scripts/android-debug.sh",
    "android:install": "bash scripts/android-debug.sh --install"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^13.2.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
