# Copy to .env. No production demo accounts are created.
APP_ENV=production
HOST=0.0.0.0
PORT=3001
DATABASE_PATH=./data/star.sqlite
BACKUP_DIR=./backups
ADMIN_USERNAME=admin
# Set a unique password with at least 12 characters before first launch.
ADMIN_PASSWORD=
# Public HTTPS origin, e.g. https://stars.example.com
APP_ORIGIN=
# Android frontend API URL; leave empty for same-origin Web.
VITE_API_URL=
DEMO_MODE=false
# Deployment connection; private key remains a local file, never in this value.
ECS_HOST=
ECS_USER=root
ECS_SSH_PORT=22
ECS_AUTH_METHOD=password
# Optional: SSH login password; leave blank for an interactive password prompt.
ECS_PASSWORD=
ECS_SSH_KEY_PATH=
ECS_APP_DIR=/opt/star
# Caddy HTTPS domain (a domain resolving to ECS is needed for automatic TLS)
DOMAIN=
